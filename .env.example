# Process timezone (an IANA zone name, e.g. "Europe/Berlin"). It also sets the
# timezone the cron expressions of device scripts' jobs are evaluated in; a
# job may override it with a "TZ=<zone>" or "CRON_TZ=<zone>" prefix on its
# cron string.
export TZ=Europe/Berlin
export LOG_LEVEL=debug

# HTTP port of the API and UI. Defaults to 8080.
export HL_HTTP_PORT=8080

# Filesystem path of the embedded SQLite database that persists every incoming
# device event's payload (keyed by IEEE address, queryable per device).
# Defaults to "data/homeland.db"; the parent directory must exist (mounted at
# deploy time) and be on a local filesystem: the database runs in WAL mode,
# which keeps homeland.db-wal and homeland.db-shm next to it and does not work
# over NFS/SMB.
export HL_DB_PATH=data/homeland.db
# Delete events older than this duration (e.g. 720h = 30 days). Defaults to
# 720h (30 days). Set to 0 to disable age-based pruning.
export HL_DB_RETENTION_MAX_AGE=720h
# Keep only the newest N events per device. Defaults to 0 (unlimited): no
# per-device cap unless set.
export HL_DB_RETENTION_MAX_PER_DEVICE=
# Event-store retention (pruning of old events). A cleanup runs at startup and
# then every HL_DB_RETENTION_INTERVAL. Defaults to 1h.
export HL_DB_RETENTION_INTERVAL=1h

# Zigbee2MQTT broker (required). BASE_TOPIC must match Zigbee2MQTT's
# mqtt.base_topic and defaults to "zigbee2mqtt". CLIENT_ID defaults to
# "homeland-dev".
export HL_Z2M_MQTT_BROKER=tcp://localhost:1883
export HL_Z2M_MQTT_CLIENT_ID=homeland-dev
export HL_Z2M_MQTT_USERNAME=homeland-dev
export HL_Z2M_MQTT_PASSWORD=
export HL_Z2M_MQTT_BASE_TOPIC=zigbee2mqtt
# When true, the z2m connection is consume-only: it still subscribes and
# receives messages, but publishes are logged instead of sent to the broker.
export HL_Z2M_MQTT_READONLY=false

# External broker for ctx.mqtt.publish (non-z2m devices, e.g. an awtrix3 clock).
# Leave HL_EXT_MQTT_BROKER empty to disable ctx.mqtt: when unset, ctx.mqtt.publish
# throws inside scripts instead of falling back to the HL_Z2M_MQTT connection.
export HL_EXT_MQTT_BROKER=
# Must differ from HL_Z2M_MQTT_CLIENT_ID when both use the same broker, or the
# two connections keep disconnecting each other. Startup fails when both use
# the same id with the same broker URL.
export HL_EXT_MQTT_CLIENT_ID=homeland-ext-dev
export HL_EXT_MQTT_USERNAME=
export HL_EXT_MQTT_PASSWORD=
# Optional prefix for every ctx.mqtt.publish topic. Defaults to none.
export HL_EXT_MQTT_BASE_TOPIC=
# When true, ctx.mqtt.publish logs instead of sending to the external broker.
export HL_EXT_MQTT_READONLY=false

# Directory holding device scripts, named "<device-id>.js" where the id is a
# friendly name or an IEEE address; mounted at deploy time. Defaults to
# "scripts" (relative to the working directory).
export HL_SCRIPTS_DIR=scripts
# When true, the scripts directory is watched at runtime and the handler cache
# is kept in sync as scripts are added, changed, or removed. When false (the
# default) scripts are compiled once at startup and never re-read.
export HL_SCRIPTS_WATCHER=false
# Max time a single script run (the one-time top-level evaluation, a handle
# call or a job run, including any ctx.sleep) may take before it is
# interrupted. Guards against a runaway script (e.g. an infinite loop) stalling
# event delivery. Defaults to 5s; set to 0 to disable the watchdog (scripts may
# run unbounded). This example uses 2s.
export HL_SCRIPTS_TIMEOUT=2s
