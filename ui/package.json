{
  "name": "homeland-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "NODE_ENV=development vite build --watch --mode development",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test": "npm run test:unit",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint-fix": "run-s \"lint-fix:*\"",
    "lint-fix:oxlint": "npm run lint:oxlint -- --fix",
    "lint-fix:eslint": "npm run lint:eslint -- --fix",
    "fmt": "oxfmt . --write",
    "fmt-check": "oxfmt . --check",
    "ci": "run-p lint fmt-check type-check test"
  },
  "dependencies": {
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "bootstrap-icons": "^1.13.2",
    "codejar": "^4.3.0",
    "codejar-linenumbers": "^1.0.1",
    "luxon": "^3.7.2",
    "pinia": "^4.1.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.6"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.88.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
